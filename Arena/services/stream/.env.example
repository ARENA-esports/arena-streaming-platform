# =============================================================================
# Stream Service — Environment Variables Template
# Copy this file to .env and fill in real values. Never commit the real .env
# =============================================================================

# ---- App ----
ASPNETCORE_ENVIRONMENT=Development
STREAM_SERVICE_PORT=5003

# ---- Database (arena_stream_db) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=arena_stream_db
DB_USER=arena_stream_user
DB_PASSWORD=change_me

# Full ADO.NET connection string (maps to ConnectionStrings:DefaultConnection in ASP.NET Core)
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=arena_stream_db;Uid=arena_stream_user;Pwd=change_me;AllowUserVariables=True;

# ---- Twitch Embed & Developer App (dev.twitch.tv) ----
DEFAULT_EMBED_PARENT_DOMAIN=localhost
TWITCH_CLIENT_ID=twitch_client_id
TWITCH_CLIENT_SECRET=twitch_client_secret

# ---- Twitch EventSub Webhook ----
# HMAC-SHA256 secret (10–100 chars) used to verify inbound webhook signatures
TWITCH_EVENTSUB_SECRET=changeme_min_10_chars

# Public HTTPS URL Twitch will POST events to (e.g. ngrok tunnel URL in local dev)
TWITCH_EVENTSUB_CALLBACK_URL=https://your-ngrok-subdomain.ngrok-free.app/webhooks/twitch

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_STREAM_STARTED_TOPIC=stream.started
KAFKA_STREAM_ENDED_TOPIC=stream.ended

# ---- JWT Configuration (docs/jwt-spec.md) ----
JwtSettings__Secret=change_me_shared_secret_across_all_services_min_32_chars!
JwtSettings__Issuer=Arena.UserService
JwtSettings__Audience=Arena.Platform
JwtSettings__ExpiryMinutes=120
