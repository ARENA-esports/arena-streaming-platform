{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=arena_battle_db;Uid=root;Pwd=;AllowUserVariables=True;"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "Arena.UserService",
    "Audience": "Arena.Platform"
  },
  "Economy": {
    "WatchTickIntervalSeconds": 55,
    "WatchTickCoinsAwarded": 10,
    "CoinCapWindowSeconds": 300,
    "CoinCapPerWindow": 50
  },
  "StreamService": {
    "BaseUrl": "http://localhost:5167",
    "TimeoutSeconds": 2,
    "RetryCount": 1
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "coin.earned"
  }
}