# =============================================================================
# Arena Platform — Docker Compose Environment Variables Template
# Copy this file to .env and fill in real values. Never commit the real .env.
# =============================================================================

# ---- Shared JWT Secret (required by all backend services) ----
# Must be the same value across user, stream, and tournament services.
JWT_SECRET=change_me_shared_secret_across_all_services_min_32_chars!

# ---- Shared MySQL (stream + tournament databases) ----
MYSQL_ROOT_PASSWORD=rootpassword

# ---- Frontend Build Variables (VITE_*) ----
# Leave blank for local development — services are proxied by Nginx in Docker or Vite in dev mode.

# Absolute URL of the User Service API (e.g. https://arena-user.azurewebsites.net)
VITE_USER_API_URL=

# Absolute URL of the Stream Service API (e.g. https://arena-stream.azurewebsites.net)
VITE_STREAM_API_URL=

# Absolute URL of the Tournament Service API (e.g. https://arena-tournament.azurewebsites.net)
VITE_TOURNAMENT_API_URL=

# Parent domain for Twitch embed allow-list (e.g. your Azure Static Web App domain)
VITE_APP_DOMAIN=localhost

# Optional: override Twitch channel for testing
VITE_TWITCH_TEST_CHANNEL=
