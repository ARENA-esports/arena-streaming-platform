# ==============================================================================
# Arena Platform - Root Environment Variables Template
# Copy this file to .env before starting containers: `cp .env.example .env`
# ==============================================================================

# ---- JWT (shared across all backend services) ----
JWT_SECRET=Arena_Secret_Key_For_Jwt_Token_Signing_2026_SE3022_Production_Grade!

# ---- MySQL Root Password (shared across all MySQL containers) ----
MYSQL_ROOT_PASSWORD=rootpassword

# ---- MySQL User DB Credentials ----
MYSQL_PASSWORD=arena_password

# ---- Twitch OAuth Credentials ----
# Register your application at the Twitch Developer Console: https://dev.twitch.tv/console
# In Twitch Console:
#   OAuth Redirect URL: http://localhost:5168/api/auth/twitch/callback
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
